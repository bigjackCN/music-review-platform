<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.bigjackcn.musicreview.mapper.AlbumMapper">

    <select id="findAll" resultType="io.github.bigjackcn.musicreview.entity.Album">
        SELECT id, title, artist, release_year, genre, created_at
        FROM album
    </select>

</mapper>